# Required for the first administrator account on an empty database.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password-at-least-12-chars

# Required to encrypt API keys stored for users. Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Optional: enable public customer registration. Default is disabled.
ALLOW_REGISTRATION=false
NEW_USER_MONTHLY_TOKEN_LIMIT=100000

# Optional shared provider fallback (usually keep disabled when assigning a key per user).
ALLOW_SHARED_PROVIDER_FALLBACK=false
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=
AI_MODEL=

# Thinking/output mappings are provider-specific. ODiRouter Gemini 2.5 Pro is mapped automatically. Prefer the Admin model-specific mapping for mixed providers. Do not set generic fields unless every assigned model supports the exact same fields/values.
AI_THINKING_FIELD=
AI_THINKING_LOW_VALUE=low
AI_THINKING_MEDIUM_VALUE=medium
AI_THINKING_HIGH_VALUE=high
AI_THINKING_XHIGH_VALUE=xhigh
# Leave blank to avoid guessing max_tokens vs max_completion_tokens for unknown providers.
AI_MAX_OUTPUT_FIELD=
AI_THINKING_BUDGET_FIELD=

# Keep disabled on Render/public deployments: this project does not implement an OS/container sandbox.
ENABLE_WORKSPACE_COMMANDS=false
PORT=3001
NODE_ENV=development
# Optional storage root; on Render mount a persistent disk at /var/data and set APP_STORAGE_DIR=/var/data
APP_STORAGE_DIR=
